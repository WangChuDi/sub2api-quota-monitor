PORT=8320

# Sub2API connection. The account IDs are used when the four URL overrides are omitted.
SUB2API_BASE_URL=https://sub2api.example.com
SUB2API_ADMIN_KEY=replace-with-your-admin-key
MAIN_ACCOUNT_ID=571
SPARK_ACCOUNT_ID=576

# Set true to send the startup test and slope-change notifications.
BARK_ENABLED=false
BARK_URL=

# Set this when the page is embedded by a reverse proxy or New API.
FRAME_ANCESTORS='self'

# Sampling and retention.
FAST_INTERVAL_SECONDS=60
NORMAL_INTERVAL_SECONDS=300
FAST_USAGE_AMOUNT_THRESHOLD=5
FAST_USAGE_REQUEST_THRESHOLD=20
FAST_HOLD_SECONDS=900
REQUEST_TIMEOUT=45
BARK_REQUEST_TIMEOUT=10
HISTORY_RETENTION_DAYS=90
